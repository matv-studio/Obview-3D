#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require
#include "test_common.glsl"

layout(local_size_x = 32) in;
layout(triangles, max_vertices = 64, max_primitives = 64) out;
layout(location = 0) out vec3 out_normal[];

void main() {
    uint tri_count = pc.index_count / 3;
    SetMeshOutputsEXT(pc.index_count, tri_count);
    for (uint k = gl_LocalInvocationIndex; k < pc.index_count; k += 32) {
        uint i = pc.indices.v[k];
        gl_MeshVerticesEXT[k].gl_Position = pc.view_proj * vec4(pc.positions.v[i], 1.0);
        out_normal[k] = pc.normals.v[i];
    }
    for (uint t = gl_LocalInvocationIndex; t < tri_count; t += 32) {
        gl_PrimitiveTriangleIndicesEXT[t] = uvec3(3 * t, 3 * t + 1, 3 * t + 2);
    }
}
